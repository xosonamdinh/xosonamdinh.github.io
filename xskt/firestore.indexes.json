{
  "indexes": [

    // ------------------------------------------------------------------
    // veLoTo: query by ngay + daiLyId (e.g. list tickets for an agent on a date)
    // ------------------------------------------------------------------
    {
      "collectionGroup": "veLoTo",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ngay",    "order": "ASCENDING" },
        { "fieldPath": "daiLyId", "order": "ASCENDING" }
      ]
    },

    // ------------------------------------------------------------------
    // veLoTo: query by ngay + donViId (e.g. list tickets for a unit on a date)
    // ------------------------------------------------------------------
    {
      "collectionGroup": "veLoTo",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ngay",   "order": "ASCENDING" },
        { "fieldPath": "donViId","order": "ASCENDING" }
      ]
    },

    // ------------------------------------------------------------------
    // ketQuaThuong: query prize results by date + agent
    // ------------------------------------------------------------------
    {
      "collectionGroup": "ketQuaThuong",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ngay",    "order": "ASCENDING" },
        { "fieldPath": "daiLyId", "order": "ASCENDING" }
      ]
    },

    // ------------------------------------------------------------------
    // daiLy: list agents under a unit ordered by their code
    // ------------------------------------------------------------------
    {
      "collectionGroup": "daiLy",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "donViId", "order": "ASCENDING" },
        { "fieldPath": "ma",      "order": "ASCENDING" }
      ]
    },

    // ------------------------------------------------------------------
    // kyMoThuong: list draw sessions newest-first (dashboard / history view)
    // ------------------------------------------------------------------
    {
      "collectionGroup": "kyMoThuong",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ngay", "order": "DESCENDING" }
      ]
    }

  ],

  "fieldOverrides": []
}
