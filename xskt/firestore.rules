rules_version = '2';

// =============================================================================
// XSKT Lô Tô – Firestore Security Rules
// =============================================================================
//
// Roles stored in /users/{uid} document:
//   role: "admin" | "may" | "daily"
//
// Helper functions resolve the role from the authenticated user's own document.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    /// Returns true when the request carries a valid authenticated session.
    function isAuth() {
      return request.auth != null;
    }

    /// Fetch the calling user's profile document (cached by Firestore per request).
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /// Returns true when the authenticated user has the "admin" role.
    function isAdmin() {
      return isAuth() && userDoc().role == 'admin';
    }

    /// Returns true when the authenticated user has the "may" (machine/terminal) role.
    function isMay() {
      return isAuth() && userDoc().role == 'may';
    }

    /// Returns true when the authenticated user has the "daily" (agent/dealer) role.
    function isDaily() {
      return isAuth() && userDoc().role == 'daily';
    }

    /// Returns true when the caller is either an admin or a may (machine) user.
    function isAdminOrMay() {
      return isAdmin() || isMay();
    }

    /// Returns true when the document belongs to the calling user (uid match).
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // -------------------------------------------------------------------------
    // /users/{userId}
    // -------------------------------------------------------------------------
    // • A user can read/write their own document.
    // • Admin can read/write any user document (e.g., to assign roles).
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // -------------------------------------------------------------------------
    // /donVi/{donViId}  – Đơn vị (Company / Unit)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read.
    // • Only admin can create / update / delete.
    // -------------------------------------------------------------------------
    match /donVi/{donViId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /daiLy/{daiLyId}  – Đại lý (Agent / Dealer)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read.
    // • Only admin can create / update / delete.
    // -------------------------------------------------------------------------
    match /daiLy/{daiLyId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /toSo/{toSoId}  – Tờ số (Ticket sheet configuration)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read.
    // • Only admin can create / update / delete.
    // -------------------------------------------------------------------------
    match /toSo/{toSoId} {
      allow read:   if isAuth();
      allow write:  if isAdmin();
    }

    // -------------------------------------------------------------------------
    // /kyMoThuong/{kyId}  – Kỳ mở thưởng (Draw period / session)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read.
    // • Admin and may (machine) users can write (open/close/update a draw).
    // • daily (agent) users are read-only.
    // -------------------------------------------------------------------------
    match /kyMoThuong/{kyId} {
      allow read:  if isAuth();
      allow write: if isAdminOrMay();
    }

    // -------------------------------------------------------------------------
    // /veLoTo/{veId}  – Vé lô tô (Lottery tickets)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read and write (create / update tickets).
    //   Fine-grained ownership checks (e.g. daily can only write their own
    //   tickets) should be enforced in application logic or via additional
    //   field-level rules if required.
    // -------------------------------------------------------------------------
    match /veLoTo/{veId} {
      allow read:  if isAuth();
      allow write: if isAuth();
    }

    // -------------------------------------------------------------------------
    // /ketQuaXs/{ketQuaId}  – Kết quả xổ số (Lottery draw results)
    // -------------------------------------------------------------------------
    // • Only admin or may (machine) users can read and write draw results.
    //   (Results are entered by the machine terminal or admin.)
    // -------------------------------------------------------------------------
    match /ketQuaXs/{ketQuaId} {
      allow read:  if isAdminOrMay();
      allow write: if isAdminOrMay();
    }

    // -------------------------------------------------------------------------
    // /ketQuaThuong/{ketQuaThuongId}  – Kết quả trúng thưởng (Prize results)
    // -------------------------------------------------------------------------
    // • Any authenticated user can read prize results (agents check payouts).
    // • Only admin or may users can write (compute and record prize results).
    // -------------------------------------------------------------------------
    match /ketQuaThuong/{ketQuaThuongId} {
      allow read:  if isAuth();
      allow write: if isAdminOrMay();
    }

    // -------------------------------------------------------------------------
    // Deny all other collections by default (implicit Firestore deny, but
    // explicit catch-all makes intent clear).
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read:  if false;
      allow write: if false;
    }

  }
}
